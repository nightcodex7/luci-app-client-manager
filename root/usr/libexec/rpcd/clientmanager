#!/usr/bin/env lua

local json = require "luci.jsonc"

---------------------------------------------------------------------
-- Utilities
---------------------------------------------------------------------

local function read_file(path)
	local f = io.open(path, "r")
	if not f then return nil end
	local c = f:read("*a")
	f:close()
	return c
end

local function exec(cmd)
	local p = io.popen(cmd .. " 2>/dev/null", "r")
	if not p then return "" end
	local o = p:read("*a")
	p:close()
	return o or ""
end

local function exec_json(cmd)
	local raw = exec(cmd)
	if raw == "" then return nil end
	return json.parse(raw)
end

local function uci_cursor()
	return require("luci.model.uci").cursor()
end

local function ip_to_num(ip)
	if not ip or ip == "" then return 0 end
	local a, b, c, d = ip:match("(%d+)%.(%d+)%.(%d+)%.(%d+)")
	if not a then return 0 end
	return tonumber(a) * 16777216 + tonumber(b) * 65536 +
	       tonumber(c) * 256 + tonumber(d)
end

---------------------------------------------------------------------
-- Data collection
---------------------------------------------------------------------

local function get_dhcp_leases()
	local leases = {}
	local raw = read_file("/tmp/dhcp.leases")
	if not raw then return leases end
	for line in raw:gmatch("[^\n]+") do
		local ts, mac, ip, host = line:match("^(%S+)%s+(%S+)%s+(%S+)%s+(%S+)")
		if mac then
			mac = mac:upper()
			leases[mac] = {
				mac = mac, ip = ip,
				hostname = (host ~= "*") and host or nil,
				expires = tonumber(ts) or 0
			}
		end
	end
	return leases
end

local function get_arp_entries()
	local entries = {}
	local raw = read_file("/proc/net/arp")
	if not raw then return entries end
	-- /proc/net/arp format:
	-- IP HW_type Flags HW_address Mask Device
	local skip = true
	for line in raw:gmatch("[^\n]+") do
		if skip then skip = false else
			local ip, hw, flags, mac, mask, dev =
				line:match("(%S+)%s+(%S+)%s+(%S+)%s+(%S+)%s+(%S+)%s+(%S+)")
			if mac and mac ~= "00:00:00:00:00:00" and flags ~= "0x0" then
				mac = mac:upper()
				entries[mac] = { ip = ip, interface = dev }
			end
		end
	end
	return entries
end

local function get_wireless_assoc()
	local wl = {}
	local devs = exec_json("ubus call iwinfo devices")
	if not devs or not devs.devices then return wl end
	for _, dev in ipairs(devs.devices) do
		-- Sanitize device name to prevent shell injection
		if dev:match("^[%w%-_%.]+$") then
			local al = exec_json(
				"ubus call iwinfo assoclist '{\"device\":\"" .. dev .. "\"}'")
			if al and al.results then
				for _, c in ipairs(al.results) do
					if c.mac then
						wl[c.mac:upper()] = {
							interface = dev,
							signal = c.signal,
							noise = c.noise,
							wireless = true
						}
					end
				end
			end
		end
	end
	return wl
end

local function load_meta()
	local cur = uci_cursor()
	local meta = {}
	cur:foreach("clientmanager", "client", function(s)
		if s.mac then
			meta[s.mac:upper()] = {
				name = s.name or "",
				owner = s.owner or "",
				notes = s.notes or "",
				icon = s.icon or "",
				groups = s.groups or {}
			}
		end
	end)
	return meta
end

---------------------------------------------------------------------
-- RPC methods
---------------------------------------------------------------------

local methods = {

	getStatus = {
		args = {},
		call = function()
			return { version = "0.1.0" }
		end
	},

	getClients = {
		args = {},
		call = function()
			local leases = get_dhcp_leases()
			local arp = get_arp_entries()
			local wireless = get_wireless_assoc()
			local meta = load_meta()

			local seen = {}
			local clients = {}

			-- Merge all sources
			for _, src in ipairs({ leases, arp, wireless }) do
				for mac in pairs(src) do seen[mac] = true end
			end

			for mac in pairs(seen) do
				local l = leases[mac] or {}
				local a = arp[mac] or {}
				local w = wireless[mac] or {}
				local m = meta[mac] or {}

				clients[#clients + 1] = {
					mac = mac,
					ip = l.ip or a.ip or "",
					hostname = l.hostname or "",
					name = m.name or "",
					owner = m.owner or "",
					icon = m.icon or "",
					groups = m.groups or {},
					expires = l.expires or 0,
					interface = w.interface or a.interface or "",
					wireless = w.wireless or false,
					signal = w.signal,
					noise = w.noise
				}
			end

			table.sort(clients, function(x, y)
				return ip_to_num(x.ip) < ip_to_num(y.ip)
			end)

			return { clients = clients }
		end
	},

	getClientDetail = {
		args = { mac = "" },
		call = function(args)
			if not args.mac or args.mac == "" then
				return { error = "MAC address required" }
			end
			local mac = args.mac:upper()
			local leases = get_dhcp_leases()
			local arp = get_arp_entries()
			local wireless = get_wireless_assoc()
			local meta = load_meta()

			local l = leases[mac] or {}
			local a = arp[mac] or {}
			local w = wireless[mac] or {}
			local m = meta[mac] or {}

			return {
				client = {
					mac = mac,
					ip = l.ip or a.ip or "",
					hostname = l.hostname or "",
					name = m.name or "",
					owner = m.owner or "",
					notes = m.notes or "",
					icon = m.icon or "",
					groups = m.groups or {},
					expires = l.expires or 0,
					interface = w.interface or a.interface or "",
					wireless = w.wireless or false,
					signal = w.signal,
					noise = w.noise
				}
			}
		end
	},

	setClientMeta = {
		args = { mac = "", name = "", owner = "", notes = "", icon = "" },
		call = function(args)
			if not args.mac or args.mac == "" then
				return { error = "MAC address required" }
			end
			local mac = args.mac:upper()
			local cur = uci_cursor()
			local sid = nil

			cur:foreach("clientmanager", "client", function(s)
				if s.mac and s.mac:upper() == mac then
					sid = s[".name"]
				end
			end)

			if not sid then
				sid = cur:add("clientmanager", "client")
				cur:set("clientmanager", sid, "mac", mac)
			end

			if args.name then cur:set("clientmanager", sid, "name", args.name) end
			if args.owner then cur:set("clientmanager", sid, "owner", args.owner) end
			if args.notes then cur:set("clientmanager", sid, "notes", args.notes) end
			if args.icon then cur:set("clientmanager", sid, "icon", args.icon) end

			cur:commit("clientmanager")
			return { success = true }
		end
	},

	getWifiInterfaces = {
		args = {},
		call = function()
			local cur = uci_cursor()
			local ifaces = {}
			cur:foreach("wireless", "wifi-iface", function(s)
				local entry = {
					section = s[".name"],
					device = s.device or "",
					ssid = s.ssid or "",
					mode = s.mode or "ap",
					macfilter = s.macfilter or "disable",
					maclist = s.maclist or {},
					disabled = s.disabled or "0"
				}
				if entry.mode == "ap" then
					ifaces[#ifaces + 1] = entry
				end
			end)
			return { interfaces = ifaces }
		end
	},

	setMacFilter = {
		args = { section = "", mac = "", action = "" },
		call = function(args)
			if not args.section or not args.mac or not args.action then
				return { error = "section, mac, and action required" }
			end

			local mac = args.mac:upper()
			local cur = uci_cursor()

			if args.action == "add" then
				local current = cur:get("wireless", args.section, "macfilter")
				if not current or current == "disable" then
					cur:set("wireless", args.section, "macfilter", "allow")
				end
				cur:del_list("wireless", args.section, "maclist", mac)
				cur:add_list("wireless", args.section, "maclist", mac)
			elseif args.action == "remove" then
				cur:del_list("wireless", args.section, "maclist", mac)
			end

			cur:commit("wireless")
			os.execute("wifi reload &")
			return { success = true }
		end
	},

	setFirewallRule = {
		args = { mac = "", action = "" },
		call = function(args)
			if not args.mac or not args.action then
				return { error = "mac and action required" }
			end

			local mac = args.mac:upper()
			local cur = uci_cursor()
			local rule_name = "cm_" .. mac:gsub(":", "")

			-- Collect sections to delete first (cannot delete during foreach)
			local to_delete = {}
			cur:foreach("firewall", "rule", function(s)
				if s.name == rule_name then
					to_delete[#to_delete + 1] = s[".name"]
				end
			end)
			for i = #to_delete, 1, -1 do
				cur:delete("firewall", to_delete[i])
			end

			if args.action == "block" then
				local sid = cur:add("firewall", "rule")
				cur:set("firewall", sid, "name", rule_name)
				cur:set("firewall", sid, "src", "lan")
				cur:set("firewall", sid, "dest", "wan")
				cur:set("firewall", sid, "src_mac", mac)
				cur:set("firewall", sid, "target", "REJECT")
				cur:set("firewall", sid, "comment",
					"Client Manager: block " .. mac)
			end

			cur:commit("firewall")
			os.execute("/etc/init.d/firewall reload &")
			return { success = true }
		end
	},

	getFirewallRules = {
		args = {},
		call = function()
			local cur = uci_cursor()
			local rules = {}
			cur:foreach("firewall", "rule", function(s)
				if s.name and s.name:match("^cm_") then
					rules[#rules + 1] = {
						section = s[".name"],
						name = s.name,
						src_mac = s.src_mac or "",
						target = s.target or "",
						comment = s.comment or ""
					}
				end
			end)
			return { rules = rules }
		end
	},

	deleteFirewallRule = {
		args = { mac = "" },
		call = function(args)
			if not args.mac then return { error = "mac required" } end
			local rule_name = "cm_" .. args.mac:upper():gsub(":", "")
			local cur = uci_cursor()
			local to_delete = {}
			cur:foreach("firewall", "rule", function(s)
				if s.name == rule_name then
					to_delete[#to_delete + 1] = s[".name"]
				end
			end)
			for i = #to_delete, 1, -1 do
				cur:delete("firewall", to_delete[i])
			end
			cur:commit("firewall")
			os.execute("/etc/init.d/firewall reload &")
			return { success = true }
		end
	},

	getBandwidth = {
		args = {},
		call = function()
			local clients = {}
			-- conntrack -L lines have two directions:
			-- proto ... src=A dst=B ... bytes=X src=B dst=A ... bytes=Y
			-- First bytes=X is upload from A, second bytes=Y is download to A
			local ct = exec("conntrack -L -o extended 2>/dev/null")
			if ct ~= "" then
				local by_ip = {}  -- ip -> { tx=N, rx=N }
				for line in ct:gmatch("[^\n]+") do
					-- Extract first src (originator) and both bytes values
					local src = line:match("src=(%d+%.%d+%.%d+%.%d+)")
					if src then
						local b1, b2 = line:match("bytes=(%d+).-bytes=(%d+)")
						if b1 then
							if not by_ip[src] then
								by_ip[src] = { tx = 0, rx = 0 }
							end
							by_ip[src].tx = by_ip[src].tx + tonumber(b1)
							by_ip[src].rx = by_ip[src].rx + tonumber(b2)
						end
					end
				end
				for ip, d in pairs(by_ip) do
					clients[#clients + 1] = {
						ip = ip,
						tx = d.tx,
						rx = d.rx,
						bytes = d.tx + d.rx
					}
				end
			end
			table.sort(clients, function(a, b)
				return a.bytes > b.bytes
			end)
			return { bandwidth = clients }
		end
	},

	getGroups = {
		args = {},
		call = function()
			local cur = uci_cursor()
			local groups = {}
			cur:foreach("clientmanager", "group", function(s)
				groups[#groups + 1] = {
					section = s[".name"],
					id = s.id or s[".name"],
					name = s.name or "",
					description = s.description or "",
					block_internet = s.block_internet or "0"
				}
			end)
			return { groups = groups }
		end
	},

	setGroup = {
		args = { id = "", name = "", description = "", block_internet = "0" },
		call = function(args)
			if not args.id or args.id == "" then
				return { error = "group id required" }
			end
			local cur = uci_cursor()
			local sid = nil

			cur:foreach("clientmanager", "group", function(s)
				if (s.id or s[".name"]) == args.id then
					sid = s[".name"]
				end
			end)

			if not sid then
				sid = cur:add("clientmanager", "group")
				cur:set("clientmanager", sid, "id", args.id)
			end

			if args.name then
				cur:set("clientmanager", sid, "name", args.name)
			end
			if args.description then
				cur:set("clientmanager", sid, "description", args.description)
			end
			if args.block_internet then
				cur:set("clientmanager", sid, "block_internet",
					args.block_internet)
			end

			cur:commit("clientmanager")
			return { success = true }
		end
	},

	deleteGroup = {
		args = { id = "" },
		call = function(args)
			if not args.id then return { error = "group id required" } end
			local cur = uci_cursor()
			local to_delete = {}
			cur:foreach("clientmanager", "group", function(s)
				if (s.id or s[".name"]) == args.id then
					to_delete[#to_delete + 1] = s[".name"]
				end
			end)
			for i = #to_delete, 1, -1 do
				cur:delete("clientmanager", to_delete[i])
			end
			cur:commit("clientmanager")
			return { success = true }
		end
	},

	assignGroup = {
		args = { mac = "", group = "", action = "" },
		call = function(args)
			if not args.mac or not args.group or not args.action then
				return { error = "mac, group, and action required" }
			end
			local mac = args.mac:upper()
			local cur = uci_cursor()
			local sid = nil

			cur:foreach("clientmanager", "client", function(s)
				if s.mac and s.mac:upper() == mac then
					sid = s[".name"]
				end
			end)

			if not sid then
				sid = cur:add("clientmanager", "client")
				cur:set("clientmanager", sid, "mac", mac)
			end

			if args.action == "add" then
				cur:del_list("clientmanager", sid, "groups", args.group)
				cur:add_list("clientmanager", sid, "groups", args.group)
			elseif args.action == "remove" then
				cur:del_list("clientmanager", sid, "groups", args.group)
			end

			cur:commit("clientmanager")
			return { success = true }
		end
	},

	getHistory = {
		args = {},
		call = function()
			local raw = read_file("/tmp/clientmanager/history.json")
			if not raw then return { events = {} } end
			local data = json.parse(raw)
			if not data or not data.events then
				return { events = {} }
			end
			return { events = data.events }
		end
	},

	getStatistics = {
		args = {},
		call = function()
			local stats = { available = false }

			-- Check vnstat
			local vnstat = exec_json("vnstat --json 2>/dev/null")
			if vnstat then
				stats.available = true
				stats.source = "vnstat"
				stats.data = vnstat
			end

			return stats
		end
	}
}

---------------------------------------------------------------------
-- rpcd exec protocol
---------------------------------------------------------------------

if arg[1] == "list" then
	local rv = {}
	for k, v in pairs(methods) do
		rv[k] = v.args or {}
	end
	print(json.stringify(rv))
elseif arg[1] == "call" then
	local fn = methods[arg[2]]
	if fn then
		local input = json.parse(io.read("*a") or "{}") or {}
		print(json.stringify(fn.call(input)))
	else
		print(json.stringify({ error = "Method not found" }))
	end
end
