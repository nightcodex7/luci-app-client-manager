#!/bin/sh

# Handle rpcd "list" call
if [ "$1" = "list" ]; then
cat <<'EOF'
{
	"getStatus": {},
	"getClients": {},
	"getClientDetail": { "mac": "" },
	"setClientMeta": { "mac": "", "name": "", "owner": "", "notes": "", "icon": "" },
	"getWifiInterfaces": {},
	"setMacFilter": { "section": "", "mac": "", "action": "" },
	"setFirewallRule": { "mac": "", "action": "" },
	"getFirewallRules": {},
	"deleteFirewallRule": { "mac": "" },
	"getBandwidth": {},
	"getGroups": {},
	"setGroup": { "id": "", "name": "", "description": "", "block_internet": "0" },
	"deleteGroup": { "id": "" },
	"assignGroup": { "mac": "", "group": "", "action": "" },
	"getHistory": {},
	"getStatistics": {},
	"startVnstat": {}
}
EOF
	exit 0
fi

# Handle rpcd "call"
if [ "$1" = "call" ]; then
	METHOD="$2"
	INPUT=$(cat)

	case "$METHOD" in
		getStatus)
			echo '{"version":"0.1.0"}'
			;;

		getClients)
			TMP_SSID="/tmp/cm_ssid_$$.txt"
			rm -f "$TMP_SSID"

			TMP_WL="/tmp/cm_wl_$$.txt"
			rm -f "$TMP_WL"
			if command -v ubus >/dev/null 2>&1; then
				# Method 1: iwinfo ubus
				DEVS=$(ubus call iwinfo devices 2>/dev/null | jsonfilter -e '@.devices[*]' 2>/dev/null || true)
				for d in $DEVS; do
					S_NAME=$(ubus call iwinfo info "{\"device\":\"$d\"}" 2>/dev/null | jsonfilter -e '@.ssid' 2>/dev/null || true)
					[ -n "$S_NAME" ] && echo "$d | $S_NAME" >> "$TMP_SSID"

					ubus call iwinfo assoclist "{\"device\":\"$d\"}" 2>/dev/null | \
						jsonfilter -e "@.results[*]" -e "mac=@.mac" -e "sig=@.signal" -e "noise=@.noise" 2>/dev/null | \
						awk -v dev="$d" '
							/mac=/ { mac=toupper(substr($0, 5)) }
							/sig=/ { sig=substr($0, 5) }
							/noise=/ { noise=substr($0, 7) }
							{
								if (mac && sig) {
									print mac " " dev " " sig " " (noise ? noise : "-95")
									mac=""; sig=""; noise=""
								}
							}
						' >> "$TMP_WL" 2>/dev/null || true
				done

				# Method 2: hostapd ubus
				HDEVS=$(ubus list 2>/dev/null | grep '^hostapd\.' | cut -d. -f2- || true)
				for hd in $HDEVS; do
					ubus call "hostapd.$hd" get_clients 2>/dev/null | \
						jsonfilter -e '@.clients[*]' 2>/dev/null | \
						awk -v dev="$hd" '
							/mac=/ { mac=toupper(substr($0, 5)) }
							/signal=/ { sig=substr($0, 8) }
							{
								if (mac && sig) {
									print mac " " dev " " sig " -95"
									mac=""; sig=""
								}
							}
						' >> "$TMP_WL" 2>/dev/null || true
				done
			fi

			# Method 3: uci wireless SSID mapping
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show wireless 2>/dev/null | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
					wiface=$(uci -q get wireless.$s.ifname 2>/dev/null || uci -q get wireless.$s.device 2>/dev/null || true)
					wssid=$(uci -q get wireless.$s.ssid 2>/dev/null || true)
					if [ -n "$wssid" ]; then
						[ -n "$wiface" ] && echo "$wiface | $wssid" >> "$TMP_SSID"
						echo "$s | $wssid" >> "$TMP_SSID"
					fi
				done
			fi

			# Method 4: iw station dump
			if command -v iw >/dev/null 2>&1; then
				IW_DEVS=$(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}')
				for id in $IW_DEVS; do
					iw dev "$id" station dump 2>/dev/null | awk -v dev="$id" '
						/^Station/ { mac=toupper($2) }
						/signal:/ {
							sig=$2
							if (mac && sig) {
								print mac " " dev " " sig " -95"
								mac=""; sig=""
							}
						}
					' >> "$TMP_WL" 2>/dev/null || true
				done
			fi

			# Gather IPv6 addresses
			TMP_IP6="/tmp/cm_ip6_$$.txt"
			rm -f "$TMP_IP6"

			if command -v ip >/dev/null 2>&1; then
				ip -6 neighbor show 2>/dev/null | awk '{
					ip6 = $1
					mac = ""
					for (i=1; i<=NF; i++) {
						if ($i == "lladdr" && (i+1)<=NF) mac = toupper($(i+1))
					}
					if (mac != "" && length(mac) == 17 && ip6 !~ /^fe80/) {
						print mac " " ip6
					}
				}' >> "$TMP_IP6" 2>/dev/null || true
			fi

			for f in /tmp/hosts/odhcpd /var/etc/odhcpd.leases /tmp/dhcp.leases; do
				if [ -f "$f" ]; then
					awk '
						/mac=/ {
							ip6 = $1
							for (i=1; i<=NF; i++) {
								if ($i ~ /^mac=/) {
									mac = toupper(substr($i, 5))
									if (mac != "" && ip6 ~ /:/ && ip6 !~ /^fe80/) print mac " " ip6
								}
							}
						}
						NF >= 4 && $3 ~ /:/ {
							mac = toupper($2)
							ip6 = $3
							if (length(mac) == 17 && ip6 !~ /^fe80/) print mac " " ip6
						}
					' "$f" >> "$TMP_IP6" 2>/dev/null || true
				fi
			done

			TMP_UCI="/tmp/cm_uci_$$.txt"
			rm -f "$TMP_UCI"
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show dhcp 2>/dev/null | grep "=host" | cut -d. -f2 | cut -d= -f1); do
					umac=$(uci -q get dhcp.$s.mac 2>/dev/null | tr 'a-z' 'A-Z' | awk '{print $1}')
					uip=$(uci -q get dhcp.$s.ip 2>/dev/null || true)
					uname=$(uci -q get dhcp.$s.name 2>/dev/null || true)
					if [ -n "$umac" ]; then
						echo "$umac $uip $uname" >> "$TMP_UCI"
					fi
				done
			fi

			TMP_META="/tmp/cm_meta_$$.txt"
			rm -f "$TMP_META"
			if command -v uci >/dev/null 2>&1 && [ -f /etc/config/clientmanager ]; then
				for s in $(uci -q show clientmanager 2>/dev/null | grep "=client" | cut -d. -f2 | cut -d= -f1); do
					mmac=$(uci -q get clientmanager.$s.mac 2>/dev/null | tr 'a-z' 'A-Z')
					mname=$(uci -q get clientmanager.$s.name 2>/dev/null || true)
					mowner=$(uci -q get clientmanager.$s.owner 2>/dev/null || true)
					micon=$(uci -q get clientmanager.$s.icon 2>/dev/null || true)
					if [ -n "$mmac" ]; then
						echo "$mmac | $mname | $mowner | $micon" >> "$TMP_META"
					fi
				done
			fi

			DEF_IFACE="br-lan"
			if command -v uci >/dev/null 2>&1; then
				D_IF=$(uci -q get network.lan.device 2>/dev/null || uci -q get network.lan.ifname 2>/dev/null || true)
				[ -n "$D_IF" ] && DEF_IFACE="$D_IF"
			fi

			NOW=$(date +%s)
			LEASE_FILE="/tmp/dhcp.leases"
			ARP_FILE="/proc/net/arp"
			[ -f "$LEASE_FILE" ] || LEASE_FILE="/dev/null"
			[ -f "$ARP_FILE" ] || ARP_FILE="/dev/null"

			awk -v wl_file="$TMP_WL" -v ssid_file="$TMP_SSID" -v ip6_file="$TMP_IP6" -v uci_file="$TMP_UCI" -v meta_file="$TMP_META" -v def_if="$DEF_IFACE" -v now="$NOW" '
			BEGIN {
				print "{\"clients\":["
				first = 1

				if (ssid_file != "") {
					while ((getline < ssid_file) > 0) {
						n = split($0, parts, "|")
						if (n >= 2) {
							d = parts[1]; gsub(/^[ \t]+|[ \t]+$/, "", d)
							s = parts[2]; gsub(/^[ \t]+|[ \t]+$/, "", s)
							if (d != "" && s != "") ssid_map[d] = s
						}
					}
					close(ssid_file)
				}

				if (wl_file != "") {
					while ((getline < wl_file) > 0) {
						m = toupper($1)
						if (m != "") {
							if (!wl_if[m]) wl_if[m] = $2
							if (!wl_sig[m]) wl_sig[m] = $3
							if (!wl_noise[m]) wl_noise[m] = $4
							wl_is[m] = 1
							seen[m] = 1
						}
					}
					close(wl_file)
				}

				if (ip6_file != "") {
					while ((getline < ip6_file) > 0) {
						m = toupper($1)
						if (m != "") {
							if (!ip6[m]) ip6[m] = $2
							seen[m] = 1
						}
					}
					close(ip6_file)
				}

				if (uci_file != "") {
					while ((getline < uci_file) > 0) {
						m = toupper($1)
						if (m != "") {
							if ($2 != "") ip[m] = $2
							if ($3 != "") host[m] = $3
							seen[m] = 1
						}
					}
					close(uci_file)
				}

				if (meta_file != "") {
					while ((getline < meta_file) > 0) {
						n = split($0, parts, "|")
						if (n >= 1) {
							m = toupper(parts[1])
							gsub(/^[ \t]+|[ \t]+$/, "", m)
							if (m != "") {
								if (n >= 2) { gsub(/^[ \t]+|[ \t]+$/, "", parts[2]); meta_name[m] = parts[2] }
								if (n >= 3) { gsub(/^[ \t]+|[ \t]+$/, "", parts[3]); meta_owner[m] = parts[3] }
								if (n >= 4) { gsub(/^[ \t]+|[ \t]+$/, "", parts[4]); meta_icon[m] = parts[4] }
								seen[m] = 1
							}
						}
					}
					close(meta_file)
				}
			}

			NR == FNR {
				mac = toupper($2)
				if (length(mac) == 17 && mac ~ /^[0-9A-FA-F:]+$/) {
					ip[mac] = $3
					if ($4 != "*") host[mac] = $4
					lease_exp[mac] = $1
					seen[mac] = 1
				}
				next
			}

			{
				mac = toupper($4)
				if (length(mac) == 17 && mac ~ /^[0-9A-FA-F:]+$/ && mac != "00:00:00:00:00:00" && $3 != "0x0") {
					if (!ip[mac]) ip[mac] = $1
					if (!iface[mac]) iface[mac] = $6
					arp_active[mac] = 1
					seen[mac] = 1
				}
			}

			END {
				for (m in seen) {
					if (m == "" || m == "00:00:00:00:00:00") continue
					if (!first) printf ","
					first = 0

					if_name = wl_if[m] ? wl_if[m] : (iface[m] ? iface[m] : def_if)
					is_wl = wl_is[m] ? "true" : "false"
					sig_str = wl_sig[m] ? wl_sig[m] : "null"
					noise_str = wl_noise[m] ? wl_noise[m] : "null"

					is_conn = (wl_is[m] || arp_active[m] || (lease_exp[m] && lease_exp[m] > now)) ? "true" : "false"
					c_ssid = ssid_map[if_name] ? ssid_map[if_name] : ""

					h = host[m]; gsub(/\\/, "\\\\", h); gsub(/"/, "\\\"", h)
					mn = meta_name[m]; gsub(/\\/, "\\\\", mn); gsub(/"/, "\\\"", mn)
					mo = meta_owner[m]; gsub(/\\/, "\\\\", mo); gsub(/"/, "\\\"", mo)
					mi = meta_icon[m]; gsub(/\\/, "\\\\", mi); gsub(/"/, "\\\"", mi)
					ms = c_ssid; gsub(/\\/, "\\\\", ms); gsub(/"/, "\\\"", ms)

					printf "{\"mac\":\"%s\",\"ip\":\"%s\",\"ip6\":\"%s\",\"hostname\":\"%s\",\"name\":\"%s\",\"owner\":\"%s\",\"icon\":\"%s\",\"groups\":[],\"expires\":%s,\"interface\":\"%s\",\"ssid\":\"%s\",\"wireless\":%s,\"signal\":%s,\"noise\":%s,\"connected\":%s}",
						m, ip[m], ip6[m], h, mn, mo, mi,
						(lease_exp[m] ? lease_exp[m] : "0"), if_name, ms, is_wl, sig_str, noise_str, is_conn
				}
				print "]}"
			}
			' "$LEASE_FILE" "$ARP_FILE" > "$TMP_FILE" 2>/dev/null

			rm -f "$TMP_WL" "$TMP_SSID" "$TMP_IP6" "$TMP_UCI" "$TMP_META"

			if [ -s "$TMP_FILE" ]; then
				cat "$TMP_FILE"
				rm -f "$TMP_FILE"
			else
				echo '{"clients":[]}'
			fi
			;;

		getClientDetail)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			if [ -z "$MAC" ]; then
				echo '{"error":"MAC address required"}'
				exit 0
			fi

			IP=""
			IP6=""
			HOST=""
			LEASE_EXP="0"
			IFACE=""
			IS_WL="false"
			SIG="null"
			NOISE="null"

			# DHCP leases
			if [ -f /tmp/dhcp.leases ]; then
				LINE=$(grep -i "$MAC" /tmp/dhcp.leases | head -n 1)
				if [ -n "$LINE" ]; then
					LEASE_EXP=$(echo "$LINE" | awk '{print $1}')
					IP=$(echo "$LINE" | awk '{print $3}')
					H=$(echo "$LINE" | awk '{print $4}')
					[ "$H" != "*" ] && HOST="$H"
				fi
			fi

			# IPv6 check
			if command -v ip >/dev/null 2>&1; then
				IP6=$(ip -6 neighbor show 2>/dev/null | grep -i "$MAC" | awk '{print $1}' | grep -v '^fe80' | head -n 1 || true)
			fi

			# ARP table
			if [ -f /proc/net/arp ]; then
				ALINE=$(grep -i "$MAC" /proc/net/arp | head -n 1)
				if [ -n "$ALINE" ]; then
					[ -z "$IP" ] && IP=$(echo "$ALINE" | awk '{print $1}')
					IFACE=$(echo "$ALINE" | awk '{print $6}')
				fi
			fi

			# Wireless check (iwinfo + hostapd + iw)
			if command -v ubus >/dev/null 2>&1; then
				DEVS=$(ubus call iwinfo devices 2>/dev/null | jsonfilter -e '@.devices[*]' 2>/dev/null || true)
				for d in $DEVS; do
					ASSOC=$(ubus call iwinfo assoclist "{\"device\":\"$d\"}" 2>/dev/null || true)
					if echo "$ASSOC" | grep -qi "$MAC" 2>/dev/null; then
						IS_WL="true"
						IFACE="$d"
						SIG_VAL=$(echo "$ASSOC" | jsonfilter -e "@.results[@.mac='$MAC'].signal" 2>/dev/null || true)
						NOISE_VAL=$(echo "$ASSOC" | jsonfilter -e "@.results[@.mac='$MAC'].noise" 2>/dev/null || true)
						[ -n "$SIG_VAL" ] && SIG="$SIG_VAL"
						[ -n "$NOISE_VAL" ] && NOISE="$NOISE_VAL"
						break
					fi
				done

				if [ "$IS_WL" = "false" ]; then
					HDEVS=$(ubus list 2>/dev/null | grep '^hostapd\.' | cut -d. -f2- || true)
					for hd in $HDEVS; do
						CLIENTS=$(ubus call "hostapd.$hd" get_clients 2>/dev/null || true)
						if echo "$CLIENTS" | grep -qi "$MAC" 2>/dev/null; then
							IS_WL="true"
							IFACE="$hd"
							SIG_VAL=$(echo "$CLIENTS" | jsonfilter -e "@.clients[@.mac='$MAC'].signal" 2>/dev/null || true)
							[ -n "$SIG_VAL" ] && SIG="$SIG_VAL"
							break
						fi
					done
				fi
			fi

			if [ "$IS_WL" = "false" ] && command -v iw >/dev/null 2>&1; then
				IW_DEVS=$(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}')
				for id in $IW_DEVS; do
					ST_DUMP=$(iw dev "$id" station dump 2>/dev/null || true)
					if echo "$ST_DUMP" | grep -qi "$MAC" 2>/dev/null; then
						IS_WL="true"
						IFACE="$id"
						SIG_VAL=$(echo "$ST_DUMP" | awk -v mac="$MAC" '
							/^Station/ { curr=toupper($2) }
							/signal:/ { if (curr == mac) print $2 }
						' | head -n 1 || true)
						[ -n "$SIG_VAL" ] && SIG="$SIG_VAL"
						break
					fi
				done
			fi

			if [ -z "$IFACE" ]; then
				DEF_IF="br-lan"
				if command -v uci >/dev/null 2>&1; then
					D_IF=$(uci -q get network.lan.device 2>/dev/null || uci -q get network.lan.ifname 2>/dev/null || true)
					[ -n "$D_IF" ] && DEF_IF="$D_IF"
				fi
				IFACE="$DEF_IF"
			fi

			# Load UCI metadata
			CM_NAME=""
			CM_OWNER=""
			CM_NOTES=""
			CM_ICON=""
			CM_GROUPS="[]"
			if command -v uci >/dev/null 2>&1 && [ -f /etc/config/clientmanager ]; then
				for s in $(uci -q show clientmanager 2>/dev/null | grep "=client" | cut -d. -f2 | cut -d= -f1); do
					smac=$(uci -q get clientmanager.$s.mac 2>/dev/null | tr 'a-z' 'A-Z')
					if [ "$smac" = "$MAC" ]; then
						CM_NAME=$(uci -q get clientmanager.$s.name 2>/dev/null || true)
						CM_OWNER=$(uci -q get clientmanager.$s.owner 2>/dev/null || true)
						CM_NOTES=$(uci -q get clientmanager.$s.notes 2>/dev/null || true)
						CM_ICON=$(uci -q get clientmanager.$s.icon 2>/dev/null || true)
						# Build groups array
						GLIST="["
						GFIRST=1
						for g in $(uci -q get clientmanager.$s.groups 2>/dev/null || true); do
							[ "$GFIRST" -eq 0 ] && GLIST="${GLIST},"
							GFIRST=0
							GLIST="${GLIST}\"${g}\""
						done
						GLIST="${GLIST}]"
						CM_GROUPS="$GLIST"
						break
					fi
				done
			fi

			# Also check dhcp static host for hostname
			if [ -z "$HOST" ] && command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show dhcp 2>/dev/null | grep "=host" | cut -d. -f2 | cut -d= -f1); do
					hmac=$(uci -q get dhcp.$s.mac 2>/dev/null | tr 'a-z' 'A-Z' | awk '{print $1}')
					if [ "$hmac" = "$MAC" ]; then
						HOST=$(uci -q get dhcp.$s.name 2>/dev/null || true)
						break
					fi
				done
			fi

			json_esc() {
				printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g' | tr '\n' ' '
			}

			ESC_HOST=$(json_esc "$HOST")
			ESC_NAME=$(json_esc "$CM_NAME")
			ESC_OWNER=$(json_esc "$CM_OWNER")
			ESC_NOTES=$(json_esc "$CM_NOTES")
			ESC_ICON=$(json_esc "$CM_ICON")
			ESC_IFACE=$(json_esc "$IFACE")

			printf '{"client":{"mac":"%s","ip":"%s","ip6":"%s","hostname":"%s","name":"%s","owner":"%s","notes":"%s","icon":"%s","groups":%s,"expires":%s,"interface":"%s","wireless":%s,"signal":%s,"noise":%s}}\n' \
				"$MAC" "$IP" "$IP6" "$ESC_HOST" "$ESC_NAME" "$ESC_OWNER" "$ESC_NOTES" "$ESC_ICON" "$CM_GROUPS" "$LEASE_EXP" "$ESC_IFACE" "$IS_WL" "$SIG" "$NOISE"
			;;

		setClientMeta)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			NAME=$(echo "$INPUT" | jsonfilter -e '@.name' 2>/dev/null)
			OWNER=$(echo "$INPUT" | jsonfilter -e '@.owner' 2>/dev/null)
			NOTES=$(echo "$INPUT" | jsonfilter -e '@.notes' 2>/dev/null)
			ICON=$(echo "$INPUT" | jsonfilter -e '@.icon' 2>/dev/null)

			if [ -z "$MAC" ]; then
				echo '{"error":"MAC address required"}'
				exit 0
			fi

			[ -f /etc/config/clientmanager ] || touch /etc/config/clientmanager

			SEC=""
			for s in $(uci -q show clientmanager | grep "=client" | cut -d. -f2 | cut -d= -f1); do
				smac=$(uci -q get clientmanager.$s.mac | tr 'a-z' 'A-Z')
				if [ "$smac" = "$MAC" ]; then
					SEC="$s"
					break
				fi
			done

			if [ -z "$SEC" ]; then
				SEC=$(uci add clientmanager client)
				uci set clientmanager.$SEC.mac="$MAC"
			fi

			[ -n "$NAME" ] && uci set clientmanager.$SEC.name="$NAME" || uci -q del clientmanager.$SEC.name
			[ -n "$OWNER" ] && uci set clientmanager.$SEC.owner="$OWNER" || uci -q del clientmanager.$SEC.owner
			[ -n "$NOTES" ] && uci set clientmanager.$SEC.notes="$NOTES" || uci -q del clientmanager.$SEC.notes
			[ -n "$ICON" ] && uci set clientmanager.$SEC.icon="$ICON" || uci -q del clientmanager.$SEC.icon

			uci commit clientmanager
			echo '{"success":true}'
			;;

		getWifiInterfaces)
			IF_LIST="["
			FIRST=1
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show wireless 2>/dev/null | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
					mode=$(uci -q get wireless.$s.mode 2>/dev/null || echo "ap")
					if [ "$mode" = "ap" ]; then
						dev=$(uci -q get wireless.$s.device 2>/dev/null || true)
						ssid=$(uci -q get wireless.$s.ssid 2>/dev/null || true)
						mf=$(uci -q get wireless.$s.macfilter 2>/dev/null || echo "disable")
						dis=$(uci -q get wireless.$s.disabled 2>/dev/null || echo "0")

						MLIST="["
						MFIRST=1
						for m in $(uci -q get wireless.$s.maclist 2>/dev/null || true); do
							um=$(echo "$m" | tr 'a-z' 'A-Z')
							[ -n "$um" ] || continue
							[ "$MFIRST" -eq 0 ] && MLIST="${MLIST},"
							MFIRST=0
							MLIST="${MLIST}\"${um}\""
						done
						MLIST="${MLIST}]"

						[ "$FIRST" -eq 0 ] && IF_LIST="${IF_LIST},"
						FIRST=0
						IF_LIST="${IF_LIST}{\"section\":\"$s\",\"device\":\"$dev\",\"ssid\":\"$ssid\",\"mode\":\"$mode\",\"macfilter\":\"$mf\",\"disabled\":\"$dis\",\"maclist\":$MLIST}"
					fi
				done
			fi
			IF_LIST="${IF_LIST}]"
			echo "{\"interfaces\":$IF_LIST}"
			;;

		setMacFilter)
			SEC=$(echo "$INPUT" | jsonfilter -e '@.section' 2>/dev/null)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			ACT=$(echo "$INPUT" | jsonfilter -e '@.action' 2>/dev/null)

			if [ -n "$SEC" ] && [ -n "$MAC" ]; then
				if [ "$ACT" = "add" ]; then
					uci set wireless.$SEC.macfilter='allow'
					uci del_list wireless.$SEC.maclist="$MAC" 2>/dev/null || true
					uci add_list wireless.$SEC.maclist="$MAC"
				elif [ "$ACT" = "remove" ]; then
					uci del_list wireless.$SEC.maclist="$MAC" 2>/dev/null || true
				fi
				uci commit wireless
				wifi reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		setFirewallRule)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			ACT=$(echo "$INPUT" | jsonfilter -e '@.action' 2>/dev/null)

			if [ -n "$MAC" ]; then
				CLEAN_MAC=$(echo "$MAC" | tr -d ':')
				RULE_NAME="cm_${CLEAN_MAC}"

				# Remove existing rule with this name
				for s in $(uci -q show firewall | grep "\.name='${RULE_NAME}'" | cut -d. -f2); do
					uci delete firewall.$s 2>/dev/null || true
				done

				if [ "$ACT" = "block" ]; then
					SID=$(uci add firewall rule)
					uci set firewall.$SID.name="$RULE_NAME"
					uci set firewall.$SID.src="lan"
					uci set firewall.$SID.dest="wan"
					uci set firewall.$SID.src_mac="$MAC"
					uci set firewall.$SID.target="REJECT"
					uci set firewall.$SID.comment="Client Manager: block $MAC"
				fi
				uci commit firewall
				/etc/init.d/firewall reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		getFirewallRules)
			RULES="["
			FIRST=1
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show firewall 2>/dev/null | grep "=rule" | cut -d. -f2 | cut -d= -f1); do
					rname=$(uci -q get firewall.$s.name 2>/dev/null || true)
					case "$rname" in
						cm_*)
							smac=$(uci -q get firewall.$s.src_mac 2>/dev/null || true)
							target=$(uci -q get firewall.$s.target 2>/dev/null || true)
							comment=$(uci -q get firewall.$s.comment 2>/dev/null || true)
							[ "$FIRST" -eq 0 ] && RULES="${RULES},"
							FIRST=0
							RULES="${RULES}{\"section\":\"$s\",\"name\":\"$rname\",\"src_mac\":\"$smac\",\"target\":\"$target\",\"comment\":\"$comment\"}"
							;;
					esac
				done
			fi
			RULES="${RULES}]"
			echo "{\"rules\":$RULES}"
			;;

		deleteFirewallRule)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			if [ -n "$MAC" ]; then
				CLEAN_MAC=$(echo "$MAC" | tr -d ':')
				RULE_NAME="cm_${CLEAN_MAC}"
				for s in $(uci -q show firewall | grep "\.name='${RULE_NAME}'" | cut -d. -f2); do
					uci delete firewall.$s 2>/dev/null || true
				done
				uci commit firewall
				/etc/init.d/firewall reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		getBandwidth)
			CT=""
			if command -v conntrack >/dev/null 2>&1; then
				CT=$(conntrack -L -o extended 2>/dev/null || true)
			fi
			if [ -z "$CT" ] && [ -f /proc/net/nf_conntrack ]; then
				CT=$(cat /proc/net/nf_conntrack 2>/dev/null || true)
			elif [ -z "$CT" ] && [ -f /proc/net/ip_conntrack ]; then
				CT=$(cat /proc/net/ip_conntrack 2>/dev/null || true)
			fi

			if [ -n "$CT" ]; then
				TMP_BW="/tmp/cm_bw_$$.json"
				echo "$CT" | awk '
				BEGIN { print "{\"bandwidth\":["; first = 1 }
				{
					src_ip = ""
					b1 = 0
					b2 = 0
					found_src = 0
					for (i = 1; i <= NF; i++) {
						if ($i ~ /^src=/) {
							val = substr($i, 5)
							if (!found_src && val ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
								src_ip = val
								found_src = 1
							}
						} else if ($i ~ /^bytes=/) {
							val = substr($i, 7) + 0
							if (found_src && b1 == 0) {
								b1 = val
							} else if (found_src) {
								b2 = val
							}
						}
					}
					if (src_ip != "" && (b1 > 0 || b2 > 0)) {
						tx[src_ip] += b1
						rx[src_ip] += b2
						seen[src_ip] = 1
					}
				}
				END {
					for (ip in seen) {
						if (!first) printf ","
						first = 0
						tot = tx[ip] + rx[ip]
						printf "{\"ip\":\"%s\",\"tx\":%s,\"rx\":%s,\"bytes\":%s}", ip, tx[ip], rx[ip], tot
					}
					print "]}"
				}' > "$TMP_BW" 2>/dev/null

				if [ -s "$TMP_BW" ]; then
					cat "$TMP_BW"
					rm -f "$TMP_BW"
				else
					echo '{"bandwidth":[]}'
				fi
			else
				echo '{"bandwidth":[]}'
			fi
			;;

		getGroups)
			G_LIST="["
			FIRST=1
			if command -v uci >/dev/null 2>&1 && [ -f /etc/config/clientmanager ]; then
				for s in $(uci -q show clientmanager 2>/dev/null | grep "=group" | cut -d. -f2 | cut -d= -f1); do
					gid=$(uci -q get clientmanager.$s.id 2>/dev/null || echo "$s")
					gname=$(uci -q get clientmanager.$s.name 2>/dev/null || true)
					gdesc=$(uci -q get clientmanager.$s.description 2>/dev/null || true)
					gblk=$(uci -q get clientmanager.$s.block_internet 2>/dev/null || echo "0")
					[ "$FIRST" -eq 0 ] && G_LIST="${G_LIST},"
					FIRST=0
					G_LIST="${G_LIST}{\"section\":\"$s\",\"id\":\"$gid\",\"name\":\"$gname\",\"description\":\"$gdesc\",\"block_internet\":\"$gblk\"}"
				done
			fi
			G_LIST="${G_LIST}]"
			echo "{\"groups\":$G_LIST}"
			;;

		setGroup)
			GID=$(echo "$INPUT" | jsonfilter -e '@.id' 2>/dev/null)
			GNAME=$(echo "$INPUT" | jsonfilter -e '@.name' 2>/dev/null)
			GDESC=$(echo "$INPUT" | jsonfilter -e '@.description' 2>/dev/null)
			GBLK=$(echo "$INPUT" | jsonfilter -e '@.block_internet' 2>/dev/null)

			if [ -z "$GID" ]; then
				echo '{"error":"group id required"}'
				exit 0
			fi

			[ -f /etc/config/clientmanager ] || touch /etc/config/clientmanager

			SEC=""
			for s in $(uci -q show clientmanager | grep "=group" | cut -d. -f2 | cut -d= -f1); do
				sgid=$(uci -q get clientmanager.$s.id || echo "$s")
				if [ "$sgid" = "$GID" ]; then
					SEC="$s"
					break
				fi
			done

			if [ -z "$SEC" ]; then
				SEC=$(uci add clientmanager group)
				uci set clientmanager.$SEC.id="$GID"
			fi

			[ -n "$GNAME" ] && uci set clientmanager.$SEC.name="$GNAME"
			[ -n "$GDESC" ] && uci set clientmanager.$SEC.description="$GDESC"
			[ -n "$GBLK" ] && uci set clientmanager.$SEC.block_internet="$GBLK"

			uci commit clientmanager
			echo '{"success":true}'
			;;

		deleteGroup)
			GID=$(echo "$INPUT" | jsonfilter -e '@.id' 2>/dev/null)
			if [ -n "$GID" ]; then
				for s in $(uci -q show clientmanager | grep "=group" | cut -d. -f2 | cut -d= -f1); do
					sgid=$(uci -q get clientmanager.$s.id || echo "$s")
					if [ "$sgid" = "$GID" ]; then
						uci delete clientmanager.$s 2>/dev/null || true
					fi
				done
				# Clean up group assignments in client sections
				for c in $(uci -q show clientmanager 2>/dev/null | grep "=client" | cut -d. -f2 | cut -d= -f1); do
					uci del_list clientmanager.$c.groups="$GID" 2>/dev/null || true
				done
				uci commit clientmanager
			fi
			echo '{"success":true}'
			;;

		assignGroup)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			GRP=$(echo "$INPUT" | jsonfilter -e '@.group' 2>/dev/null)
			ACT=$(echo "$INPUT" | jsonfilter -e '@.action' 2>/dev/null)

			if [ -n "$MAC" ] && [ -n "$GRP" ]; then
				SEC=""
				for s in $(uci -q show clientmanager | grep "=client" | cut -d. -f2 | cut -d= -f1); do
					smac=$(uci -q get clientmanager.$s.mac | tr 'a-z' 'A-Z')
					if [ "$smac" = "$MAC" ]; then
						SEC="$s"
						break
					fi
				done

				if [ -z "$SEC" ]; then
					SEC=$(uci add clientmanager client)
					uci set clientmanager.$SEC.mac="$MAC"
				fi

				if [ "$ACT" = "add" ]; then
					uci del_list clientmanager.$SEC.groups="$GRP" 2>/dev/null || true
					uci add_list clientmanager.$SEC.groups="$GRP"
				elif [ "$ACT" = "remove" ]; then
					uci del_list clientmanager.$SEC.groups="$GRP" 2>/dev/null || true
				fi
				uci commit clientmanager
			fi
			echo '{"success":true}'
			;;

		getHistory)
			if [ -f /tmp/clientmanager/history.json ]; then
				cat /tmp/clientmanager/history.json
			else
				echo '{"events":[]}'
			fi
			;;

		getStatistics)
			if ! command -v vnstat >/dev/null 2>&1; then
				echo '{"available":false,"reason":"not_installed"}'
				exit 0
			fi

			if [ -x /etc/init.d/vnstat ]; then
				/etc/init.d/vnstat status >/dev/null 2>&1 || /etc/init.d/vnstat start >/dev/null 2>&1 &
			fi

			VNSTAT=""
			VNSTAT=$(vnstat --json 2>/dev/null || true)
			[ -z "$VNSTAT" ] && VNSTAT=$(vnstat --json 1 2>/dev/null || true)
			[ -z "$VNSTAT" ] && VNSTAT=$(vnstat --json d 2>/dev/null || true)

			FIRST_CHAR=$(echo "$VNSTAT" | awk '{print substr($0,1,1)}')
			if [ "$FIRST_CHAR" = "{" ]; then
				echo "{\"available\":true,\"source\":\"vnstat\",\"data\":$VNSTAT}"
			else
				echo '{"available":false,"reason":"service_stopped"}'
			fi
			;;

		startVnstat)
			if [ -x /etc/init.d/vnstat ]; then
				/etc/init.d/vnstat enable >/dev/null 2>&1 || true
				/etc/init.d/vnstat start >/dev/null 2>&1 || true
			fi
			echo '{"success":true}'
			;;

		*)
			echo '{"error":"Method not found"}'
			;;
	esac
	exit 0
fi

echo '{"error":"Invalid argument"}'
exit 1
