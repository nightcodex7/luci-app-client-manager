#!/bin/sh

# Handle rpcd "list" call
if [ "$1" = "list" ]; then
cat <<'EOF'
{
	"getStatus": {},
	"getClients": {},
	"getClientDetail": { "mac": "" },
	"getWifiInterfaces": {},
	"setMacFilter": { "section": "", "mac": "", "action": "" },
	"setFirewallRule": { "mac": "", "action": "" },
	"getFirewallRules": {},
	"deleteFirewallRule": { "mac": "" },
	"getBandwidth": {},
	"getSpeedLimits": {},
	"setSpeedLimit": { "mac": "", "ip": "", "download_val": "", "download_unit": "", "upload_val": "", "upload_unit": "" },
	"deleteSpeedLimit": { "mac": "" }
}
EOF
	exit 0
fi

# Handle rpcd "call"
if [ "$1" = "call" ]; then
	METHOD="$2"
	INPUT=$(cat)

	case "$METHOD" in
		getStatus)
			MEM_TOTAL=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
			MEM_FREE=$(awk '/MemFree|MemAvailable/ {free+=$2} END {print int(free/1024)}' /proc/meminfo 2>/dev/null || echo 0)
			LOW_RES="false"
			if [ "$MEM_TOTAL" -gt 0 ] && [ "$MEM_TOTAL" -lt 128 ]; then
				LOW_RES="true"
			fi
			printf "{\"version\":\"0.1.0\",\"mem_total_mb\":%s,\"mem_free_mb\":%s,\"low_resource\":%s}\n" \
				"$MEM_TOTAL" "$MEM_FREE" "$LOW_RES"
			;;

		getClients)
			TMP_SSID="/tmp/cm_ssid_$$.txt"
			TMP_WL="/tmp/cm_wl_$$.txt"
			TMP_IP6="/tmp/cm_ip6_$$.txt"
			TMP_UCI="/tmp/cm_uci_$$.txt"
			TMP_FILE="/tmp/cm_clients_$$.json"

			trap 'rm -f "$TMP_SSID" "$TMP_WL" "$TMP_IP6" "$TMP_UCI" "$TMP_FILE" 2>/dev/null' EXIT INT TERM
			rm -f "$TMP_SSID" "$TMP_WL" "$TMP_IP6" "$TMP_UCI" "$TMP_FILE"

			if command -v ubus >/dev/null 2>&1; then
				# Method 1: iwinfo ubus
				DEVS=$(ubus call iwinfo devices 2>/dev/null | jsonfilter -e '@.devices[*]' 2>/dev/null || true)
				for d in $DEVS; do
					INFO=$(ubus call iwinfo info "{\"device\":\"$d\"}" 2>/dev/null || true)
					S_NAME=$(echo "$INFO" | jsonfilter -e '@.ssid' 2>/dev/null || true)
					S_FREQ=$(echo "$INFO" | jsonfilter -e '@.frequency' 2>/dev/null || true)
					[ -n "$S_NAME" ] && echo "$d | $S_NAME | $S_FREQ" >> "$TMP_SSID"

					ubus call iwinfo assoclist "{\"device\":\"$d\"}" 2>/dev/null | \
						jsonfilter -e "@.results[*]" -e "mac=@.mac" -e "sig=@.signal" -e "noise=@.noise" 2>/dev/null | \
						awk -v dev="$d" '
							/mac=/ { mac=toupper(substr($0, 5)) }
							/sig=/ { sig=substr($0, 5) }
							/noise=/ { noise=substr($0, 7) }
							{
								if (mac && sig) {
									print mac " " dev " " sig " " (noise ? noise : "-95")
									mac=""; sig=""; noise=""
								}
							}
						' >> "$TMP_WL" 2>/dev/null || true
				done

				# Method 2: hostapd ubus
				HDEVS=$(ubus list 2>/dev/null | grep '^hostapd\.' | cut -d. -f2- || true)
				for hd in $HDEVS; do
					ubus call "hostapd.$hd" get_clients 2>/dev/null | \
						jsonfilter -e '@.clients[*]' 2>/dev/null | \
						awk -v dev="$hd" '
							/mac=/ { mac=toupper(substr($0, 5)) }
							/signal=/ { sig=substr($0, 8) }
							{
								if (mac && sig) {
									print mac " " dev " " sig " -95"
									mac=""; sig=""
								}
							}
						' >> "$TMP_WL" 2>/dev/null || true
				done
			fi

			# Method 3: uci wireless SSID mapping
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show wireless 2>/dev/null | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
					wiface=$(uci -q get wireless.$s.ifname 2>/dev/null || uci -q get wireless.$s.device 2>/dev/null || true)
					wssid=$(uci -q get wireless.$s.ssid 2>/dev/null || true)
					if [ -n "$wssid" ]; then
						[ -n "$wiface" ] && echo "$wiface | $wssid | " >> "$TMP_SSID"
						echo "$s | $wssid | " >> "$TMP_SSID"
					fi
				done
			fi

			# Method 4: iw station dump
			if command -v iw >/dev/null 2>&1; then
				IW_DEVS=$(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}')
				for id in $IW_DEVS; do
					iw dev "$id" station dump 2>/dev/null | awk -v dev="$id" '
						/^Station/ { mac=toupper($2) }
						/signal:/ {
							sig=$2
							if (mac && sig) {
								print mac " " dev " " sig " -95"
								mac=""; sig=""
							}
						}
					' >> "$TMP_WL" 2>/dev/null || true
				done
			fi

			# Gather IPv6 addresses
			TMP_IP6="/tmp/cm_ip6_$$.txt"
			rm -f "$TMP_IP6"
			if command -v ip >/dev/null 2>&1; then
				ip -6 neighbor show 2>/dev/null | awk '
					$1 ~ /^[0-9a-fA-F:]+$/ && $1 !~ /^fe80/ {
						for (i=1; i<=NF; i++) {
							if ($i == "lladdr" && (i+1) <= NF) {
								mac = toupper($(i+1))
								if (length(mac) == 17) print mac " " $1
							}
						}
					}
				' >> "$TMP_IP6" 2>/dev/null || true
			fi
			if [ -f /tmp/hosts/odhcpd ] || [ -f /var/etc/odhcpd.leases ]; then
				cat /tmp/hosts/odhcpd /var/etc/odhcpd.leases 2>/dev/null | awk '
					$1 ~ /^[0-9a-fA-F:]+$/ && $1 !~ /^fe80/ {
						for (i=1; i<=NF; i++) {
							if ($(i) ~ /^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$/) {
								print toupper($(i)) " " $1
							}
						}
					}
				' >> "$TMP_IP6" 2>/dev/null || true
			fi

			# Gather static lease hostnames/IPs from UCI dhcp
			TMP_UCI="/tmp/cm_uci_$$.txt"
			rm -f "$TMP_UCI"
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show dhcp 2>/dev/null | grep "=host" | cut -d. -f2 | cut -d= -f1); do
					dmac=$(uci -q get dhcp.$s.mac 2>/dev/null | tr 'a-z' 'A-Z')
					dip=$(uci -q get dhcp.$s.ip 2>/dev/null || true)
					dname=$(uci -q get dhcp.$s.name 2>/dev/null || true)
					if [ -n "$dmac" ]; then
						for m in $dmac; do
							echo "$m $dip $dname" >> "$TMP_UCI"
						done
					fi
				done
			fi

			DEF_IFACE="br-lan"
			if command -v uci >/dev/null 2>&1; then
				D_IF=$(uci -q get network.lan.device 2>/dev/null || uci -q get network.lan.ifname 2>/dev/null || true)
				[ -n "$D_IF" ] && DEF_IFACE="$D_IF"
			fi

			NOW=$(date +%s)
			LEASE_FILE="/tmp/dhcp.leases"
			ARP_FILE="/proc/net/arp"
			[ -f "$LEASE_FILE" ] || LEASE_FILE="/dev/null"
			[ -f "$ARP_FILE" ] || ARP_FILE="/dev/null"

			awk -v wl_file="$TMP_WL" -v ssid_file="$TMP_SSID" -v ip6_file="$TMP_IP6" -v uci_file="$TMP_UCI" -v def_if="$DEF_IFACE" -v now="$NOW" '
			BEGIN {
				print "{\"clients\":["
				first = 1

				if (ssid_file != "") {
					while ((getline < ssid_file) > 0) {
						n = split($0, parts, "|")
						if (n >= 2) {
							d = parts[1]; gsub(/^[ \t]+|[ \t]+$/, "", d)
							s = parts[2]; gsub(/^[ \t]+|[ \t]+$/, "", s)
							f = (n >= 3) ? parts[3] : ""; gsub(/^[ \t]+|[ \t]+$/, "", f)
							if (d != "") {
								if (s != "") ssid_map[d] = s
								if (f != "") freq_map[d] = f
							}
						}
					}
					close(ssid_file)
				}

				if (wl_file != "") {
					while ((getline < wl_file) > 0) {
						m = toupper($1)
						if (m != "") {
							if (!wl_if[m]) wl_if[m] = $2
							if (!wl_sig[m]) wl_sig[m] = $3
							if (!wl_noise[m]) wl_noise[m] = $4
							wl_is[m] = 1
							seen[m] = 1
						}
					}
					close(wl_file)
				}

				if (ip6_file != "") {
					while ((getline < ip6_file) > 0) {
						m = toupper($1)
						if (m != "") {
							if (!ip6[m]) ip6[m] = $2
							seen[m] = 1
						}
					}
					close(ip6_file)
				}

				if (uci_file != "") {
					while ((getline < uci_file) > 0) {
						m = toupper($1)
						if (m != "") {
							if ($2 != "") ip[m] = $2
							if ($3 != "") host[m] = $3
							seen[m] = 1
						}
					}
					close(uci_file)
				}
			}

			NR == FNR {
				mac = toupper($2)
				if (length(mac) == 17 && mac ~ /^[0-9A-FA-F:]+$/) {
					ip[mac] = $3
					if ($4 != "*") host[mac] = $4
					lease_exp[mac] = $1
					seen[mac] = 1
				}
				next
			}

			{
				mac = toupper($4)
				if (length(mac) == 17 && mac ~ /^[0-9A-FA-F:]+$/ && mac != "00:00:00:00:00:00" && $3 != "0x0") {
					if (!ip[mac]) ip[mac] = $1
					if (!iface[mac]) iface[mac] = $6
					arp_active[mac] = 1
					seen[mac] = 1
				}
			}

			END {
				for (m in seen) {
					if (m == "" || m == "00:00:00:00:00:00") continue
					if (!first) printf ","
					first = 0

					if_name = iface[m] ? iface[m] : (wl_if[m] ? wl_if[m] : def_if)
					if (if_name ~ /^(phy|wlan|ra|ath)[0-9]/) if_name = def_if

					is_wl = wl_is[m] ? "true" : "false"
					sig_str = wl_sig[m] ? wl_sig[m] : "null"
					noise_str = wl_noise[m] ? wl_noise[m] : "null"

					is_conn = (wl_is[m] || arp_active[m] || (lease_exp[m] && lease_exp[m] > now)) ? "true" : "false"
					raw_wlif = wl_if[m] ? wl_if[m] : if_name
					c_ssid = ssid_map[raw_wlif] ? ssid_map[raw_wlif] : (ssid_map[if_name] ? ssid_map[if_name] : "")
					c_freq = freq_map[raw_wlif] ? freq_map[raw_wlif] : (freq_map[if_name] ? freq_map[if_name] : "")

					h = host[m]; gsub(/\\/, "\\\\", h); gsub(/"/, "\\\"", h)
					ms = c_ssid; gsub(/\\/, "\\\\", ms); gsub(/"/, "\\\"", ms)
					mf = c_freq; gsub(/\\/, "\\\\", mf); gsub(/"/, "\\\"", mf)

					printf "{\"mac\":\"%s\",\"ip\":\"%s\",\"ip6\":\"%s\",\"hostname\":\"%s\",\"expires\":%s,\"interface\":\"%s\",\"ssid\":\"%s\",\"freq\":\"%s\",\"wireless\":%s,\"signal\":%s,\"noise\":%s,\"connected\":%s}",
						m, ip[m], ip6[m], h,
						(lease_exp[m] ? lease_exp[m] : "0"), if_name, ms, mf, is_wl, sig_str, noise_str, is_conn
				}
				print "]}"
			}
			' "$LEASE_FILE" "$ARP_FILE" > "$TMP_FILE" 2>/dev/null

			rm -f "$TMP_WL" "$TMP_SSID" "$TMP_IP6" "$TMP_UCI"

			if [ -s "$TMP_FILE" ]; then
				cat "$TMP_FILE"
				rm -f "$TMP_FILE"
			else
				echo '{"clients":[]}'
			fi
			;;

		getClientDetail)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			if [ -z "$MAC" ]; then
				echo '{"error":"MAC address required"}'
				exit 0
			fi

			IP=""
			IP6=""
			HOST=""
			LEASE_EXP="0"
			IFACE=""
			IS_WL="false"
			SIG="null"
			NOISE="null"
			SSID=""
			FREQ=""

			if [ -f /tmp/dhcp.leases ]; then
				LINE=$(grep -i "$MAC" /tmp/dhcp.leases | head -n 1)
				if [ -n "$LINE" ]; then
					LEASE_EXP=$(echo "$LINE" | awk '{print $1}')
					IP=$(echo "$LINE" | awk '{print $3}')
					H=$(echo "$LINE" | awk '{print $4}')
					[ "$H" != "*" ] && HOST="$H"
				fi
			fi

			if command -v ip >/dev/null 2>&1; then
				IP6=$(ip -6 neighbor show 2>/dev/null | grep -i "$MAC" | awk '{print $1}' | grep -v '^fe80' | head -n 1 || true)
			fi

			if [ -f /proc/net/arp ]; then
				ALINE=$(grep -i "$MAC" /proc/net/arp | head -n 1)
				if [ -n "$ALINE" ]; then
					[ -z "$IP" ] && IP=$(echo "$ALINE" | awk '{print $1}')
					IFACE=$(echo "$ALINE" | awk '{print $6}')
				fi
			fi

			DEF_IFACE="br-lan"
			if [ -z "$IFACE" ] || echo "$IFACE" | grep -qE '^(phy|wlan|ra|ath)[0-9]'; then
				IFACE="$DEF_IFACE"
			fi

			if command -v ubus >/dev/null 2>&1; then
				DEVS=$(ubus call iwinfo devices 2>/dev/null | jsonfilter -e '@.devices[*]' 2>/dev/null || true)
				for d in $DEVS; do
					ASSOC=$(ubus call iwinfo assoclist "{\"device\":\"$d\"}" 2>/dev/null || true)
					if echo "$ASSOC" | grep -qi "$MAC" 2>/dev/null; then
						IS_WL="true"
						INFO=$(ubus call iwinfo info "{\"device\":\"$d\"}" 2>/dev/null || true)
						SSID=$(echo "$INFO" | jsonfilter -e '@.ssid' 2>/dev/null || true)
						FREQ=$(echo "$INFO" | jsonfilter -e '@.frequency' 2>/dev/null || true)
						SIG=$(echo "$ASSOC" | jsonfilter -e "@.results[?(@.mac=='${MAC}')].signal" 2>/dev/null || true)
						NOISE=$(echo "$ASSOC" | jsonfilter -e "@.results[?(@.mac=='${MAC}')].noise" 2>/dev/null || true)
						[ -z "$SIG" ] && SIG="-65"
						[ -z "$NOISE" ] && NOISE="-95"
						break
					fi
				done
			fi

			printf "{\"mac\":\"%s\",\"ip\":\"%s\",\"ip6\":\"%s\",\"hostname\":\"%s\",\"expires\":%s,\"interface\":\"%s\",\"ssid\":\"%s\",\"freq\":\"%s\",\"wireless\":%s,\"signal\":%s,\"noise\":%s}\n" \
				"$MAC" "$IP" "$IP6" "$HOST" "$LEASE_EXP" "$IFACE" "$SSID" "$FREQ" "$IS_WL" "${SIG:-null}" "${NOISE:-null}"
			;;

		getWifiInterfaces)
			IFACES="["
			FIRST=1
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show wireless 2>/dev/null | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
					d=$(uci -q get wireless.$s.device 2>/dev/null || true)
					m=$(uci -q get wireless.$s.mode 2>/dev/null || echo "ap")
					ssid=$(uci -q get wireless.$s.ssid 2>/dev/null || true)
					disabled=$(uci -q get wireless.$s.disabled 2>/dev/null || echo "0")
					[ "$FIRST" -eq 0 ] && IFACES="${IFACES},"
					FIRST=0
					IFACES="${IFACES}{\"section\":\"$s\",\"device\":\"$d\",\"mode\":\"$m\",\"ssid\":\"$ssid\",\"disabled\":\"$disabled\"}"
				done
			fi
			IFACES="${IFACES}]"
			echo "{\"interfaces\":$IFACES}"
			;;

		setMacFilter)
			SEC=$(echo "$INPUT" | jsonfilter -e '@.section' 2>/dev/null)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			ACT=$(echo "$INPUT" | jsonfilter -e '@.action' 2>/dev/null)

			if [ -n "$SEC" ] && [ -n "$MAC" ]; then
				if [ "$ACT" = "add" ]; then
					uci set wireless.$SEC.macfilter='allow'
					uci del_list wireless.$SEC.maclist="$MAC" 2>/dev/null || true
					uci add_list wireless.$SEC.maclist="$MAC"
				elif [ "$ACT" = "remove" ]; then
					uci del_list wireless.$SEC.maclist="$MAC" 2>/dev/null || true
				fi
				uci commit wireless
				wifi reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		setFirewallRule)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			ACT=$(echo "$INPUT" | jsonfilter -e '@.action' 2>/dev/null)

			if [ -n "$MAC" ]; then
				CLEAN_MAC=$(echo "$MAC" | tr -d ':')
				RULE_NAME="cm_${CLEAN_MAC}"

				for s in $(uci -q show firewall | grep "\.name='${RULE_NAME}'" | cut -d. -f2); do
					uci delete firewall.$s 2>/dev/null || true
				done

				if [ "$ACT" = "block" ]; then
					SID=$(uci add firewall rule)
					uci set firewall.$SID.name="$RULE_NAME"
					uci set firewall.$SID.src="lan"
					uci set firewall.$SID.dest="wan"
					uci set firewall.$SID.src_mac="$MAC"
					uci set firewall.$SID.target="REJECT"
					uci set firewall.$SID.comment="Client Manager: block $MAC"
				fi
				uci commit firewall
				/etc/init.d/firewall reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		getFirewallRules)
			RULES="["
			FIRST=1
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show firewall 2>/dev/null | grep "=rule" | cut -d. -f2 | cut -d= -f1); do
					rname=$(uci -q get firewall.$s.name 2>/dev/null || true)
					case "$rname" in
						cm_*)
							smac=$(uci -q get firewall.$s.src_mac 2>/dev/null || true)
							target=$(uci -q get firewall.$s.target 2>/dev/null || true)
							comment=$(uci -q get firewall.$s.comment 2>/dev/null || true)
							[ "$FIRST" -eq 0 ] && RULES="${RULES},"
							FIRST=0
							RULES="${RULES}{\"section\":\"$s\",\"name\":\"$rname\",\"src_mac\":\"$smac\",\"target\":\"$target\",\"comment\":\"$comment\"}"
							;;
					esac
				done
			fi
			RULES="${RULES}]"
			echo "{\"rules\":$RULES}"
			;;

		deleteFirewallRule)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			if [ -n "$MAC" ]; then
				CLEAN_MAC=$(echo "$MAC" | tr -d ':')
				RULE_NAME="cm_${CLEAN_MAC}"
				for s in $(uci -q show firewall | grep "\.name='${RULE_NAME}'" | cut -d. -f2); do
					uci delete firewall.$s 2>/dev/null || true
				done
				uci commit firewall
				/etc/init.d/firewall reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		getBandwidth)
			CT=""
			if command -v conntrack >/dev/null 2>&1; then
				CT=$(conntrack -L -o extended 2>/dev/null || true)
			fi
			if [ -z "$CT" ] && [ -f /proc/net/nf_conntrack ]; then
				CT=$(cat /proc/net/nf_conntrack 2>/dev/null || true)
			elif [ -z "$CT" ] && [ -f /proc/net/ip_conntrack ]; then
				CT=$(cat /proc/net/ip_conntrack 2>/dev/null || true)
			fi

			if [ -n "$CT" ]; then
				TMP_BW="/tmp/cm_bw_$$.json"
				echo "$CT" | awk '
				BEGIN { print "{\"bandwidth\":["; first = 1 }
				{
					src_ip = ""
					b1 = 0
					b2 = 0
					found_src = 0
					for (i = 1; i <= NF; i++) {
						if ($i ~ /^src=/) {
							val = substr($i, 5)
							if (!found_src && val ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
								src_ip = val
								found_src = 1
							}
						} else if ($i ~ /^bytes=/) {
							val = substr($i, 7) + 0
							if (found_src && b1 == 0) {
								b1 = val
							} else if (found_src) {
								b2 = val
							}
						}
					}
					if (src_ip != "" && (b1 > 0 || b2 > 0)) {
						tx[src_ip] += b1
						rx[src_ip] += b2
						seen[src_ip] = 1
					}
				}
				END {
					for (ip in seen) {
						if (!first) printf ","
						first = 0
						tot = tx[ip] + rx[ip]
						printf "{\"ip\":\"%s\",\"tx\":%s,\"rx\":%s,\"bytes\":%s}", ip, tx[ip], rx[ip], tot
					}
					print "]}"
				}' > "$TMP_BW" 2>/dev/null

				if [ -s "$TMP_BW" ]; then
					cat "$TMP_BW"
					rm -f "$TMP_BW"
				else
					echo '{"bandwidth":[]}'
				fi
			else
				echo '{"bandwidth":[]}'
			fi
			;;

		getSpeedLimits)
			LIMITS="["
			FIRST=1
			if command -v uci >/dev/null 2>&1 && [ -f /etc/config/clientmanager ]; then
				for s in $(uci -q show clientmanager 2>/dev/null | grep "=limit" | cut -d. -f2 | cut -d= -f1); do
					lmac=$(uci -q get clientmanager.$s.mac 2>/dev/null || true)
					lip=$(uci -q get clientmanager.$s.ip 2>/dev/null || true)
					ldl_val=$(uci -q get clientmanager.$s.download_val 2>/dev/null || uci -q get clientmanager.$s.download_mbps 2>/dev/null || echo "0")
					ldl_unit=$(uci -q get clientmanager.$s.download_unit 2>/dev/null || echo "Mbps")
					lul_val=$(uci -q get clientmanager.$s.upload_val 2>/dev/null || uci -q get clientmanager.$s.upload_mbps 2>/dev/null || echo "0")
					lul_unit=$(uci -q get clientmanager.$s.upload_unit 2>/dev/null || echo "Mbps")
					if [ -n "$lmac" ]; then
						[ "$FIRST" -eq 0 ] && LIMITS="${LIMITS},"
						FIRST=0
						LIMITS="${LIMITS}{\"section\":\"$s\",\"mac\":\"$lmac\",\"ip\":\"$lip\",\"download_val\":\"$ldl_val\",\"download_unit\":\"$ldl_unit\",\"upload_val\":\"$lul_val\",\"upload_unit\":\"$lul_unit\"}"
					fi
				done
			fi
			LIMITS="${LIMITS}]"
			echo "{\"limits\":$LIMITS}"
			;;

		setSpeedLimit)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			IP=$(echo "$INPUT" | jsonfilter -e '@.ip' 2>/dev/null)
			DL_VAL=$(echo "$INPUT" | jsonfilter -e '@.download_val' 2>/dev/null || echo "0")
			DL_UNIT=$(echo "$INPUT" | jsonfilter -e '@.download_unit' 2>/dev/null || echo "Mbps")
			UL_VAL=$(echo "$INPUT" | jsonfilter -e '@.upload_val' 2>/dev/null || echo "0")
			UL_UNIT=$(echo "$INPUT" | jsonfilter -e '@.upload_unit' 2>/dev/null || echo "Mbps")

			if [ -n "$MAC" ]; then
				[ -f /etc/config/clientmanager ] || touch /etc/config/clientmanager
				CLEAN_MAC=$(echo "$MAC" | tr -d ':')
				SEC_NAME="lim_${CLEAN_MAC}"

				uci delete clientmanager.$SEC_NAME 2>/dev/null || true

				if [ -n "$DL_VAL" ] && [ "$DL_VAL" != "0" ] || [ -n "$UL_VAL" ] && [ "$UL_VAL" != "0" ]; then
					uci set clientmanager.$SEC_NAME=limit
					uci set clientmanager.$SEC_NAME.mac="$MAC"
					uci set clientmanager.$SEC_NAME.ip="$IP"
					uci set clientmanager.$SEC_NAME.download_val="$DL_VAL"
					uci set clientmanager.$SEC_NAME.download_unit="$DL_UNIT"
					uci set clientmanager.$SEC_NAME.upload_val="$UL_VAL"
					uci set clientmanager.$SEC_NAME.upload_unit="$UL_UNIT"
				fi
				uci commit clientmanager

				# Apply dynamic nftables / iptables rules if IP is present
				if [ -n "$IP" ] && command -v nft >/dev/null 2>&1; then
					nft delete rule inet fw4 forward ip daddr "$IP" 2>/dev/null || true
					nft delete rule inet fw4 forward ip saddr "$IP" 2>/dev/null || true

					if [ -n "$DL_VAL" ] && [ "$DL_VAL" != "0" ]; then
						DL_BYTES=$(awk -v val="$DL_VAL" -v unit="$DL_UNIT" 'BEGIN {
							v = val + 0
							if (unit == "MBps") bytes = v * 1000000
							else if (unit == "Kbps") bytes = v * 1000 / 8
							else if (unit == "KBps") bytes = v * 1000
							else bytes = v * 1000000 / 8
							print int(bytes)
						}')
						nft add rule inet fw4 forward ip daddr "$IP" limit rate over "${DL_BYTES} bytes/second" drop 2>/dev/null || true
					fi

					if [ -n "$UL_VAL" ] && [ "$UL_VAL" != "0" ]; then
						UL_BYTES=$(awk -v val="$UL_VAL" -v unit="$UL_UNIT" 'BEGIN {
							v = val + 0
							if (unit == "MBps") bytes = v * 1000000
							else if (unit == "Kbps") bytes = v * 1000 / 8
							else if (unit == "KBps") bytes = v * 1000
							else bytes = v * 1000000 / 8
							print int(bytes)
						}')
						nft add rule inet fw4 forward ip saddr "$IP" limit rate over "${UL_BYTES} bytes/second" drop 2>/dev/null || true
					fi
				fi
			fi
			echo '{"success":true}'
			;;

		deleteSpeedLimit)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			if [ -n "$MAC" ]; then
				[ -f /etc/config/clientmanager ] || touch /etc/config/clientmanager
				CLEAN_MAC=$(echo "$MAC" | tr -d ':')
				SEC_NAME="lim_${CLEAN_MAC}"
				
				IP=$(uci -q get clientmanager.$SEC_NAME.ip 2>/dev/null || true)
				if [ -n "$IP" ] && command -v nft >/dev/null 2>&1; then
					nft delete rule inet fw4 forward ip daddr "$IP" 2>/dev/null || true
					nft delete rule inet fw4 forward ip saddr "$IP" 2>/dev/null || true
				fi

				uci delete clientmanager.$SEC_NAME 2>/dev/null || true
				uci commit clientmanager
			fi
			echo '{"success":true}'
			;;

		*)
			echo '{"error":"Method not found"}'
			;;
	esac
	exit 0
fi

echo '{"error":"Invalid argument"}'
exit 1
