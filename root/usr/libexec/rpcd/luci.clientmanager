#!/bin/sh

# Handle rpcd "list" call
if [ "$1" = "list" ]; then
cat <<'EOF'
{
	"getStatus": {},
	"getClients": {},
	"getClientDetail": { "mac": "" },
	"setClientMeta": { "mac": "", "name": "", "owner": "", "notes": "", "icon": "" },
	"getWifiInterfaces": {},
	"setMacFilter": { "section": "", "mac": "", "action": "" },
	"setFirewallRule": { "mac": "", "action": "" },
	"getFirewallRules": {},
	"deleteFirewallRule": { "mac": "" },
	"getBandwidth": {},
	"getGroups": {},
	"setGroup": { "id": "", "name": "", "description": "", "block_internet": "0" },
	"deleteGroup": { "id": "" },
	"assignGroup": { "mac": "", "group": "", "action": "" },
	"getHistory": {},
	"getStatistics": {}
}
EOF
	exit 0
fi

# Handle rpcd "call"
if [ "$1" = "call" ]; then
	METHOD="$2"
	INPUT=$(cat)

	case "$METHOD" in
		getStatus)
			echo '{"version":"0.1.0"}'
			;;

		getClients)
			# Fast, robust client aggregation in pure shell & awk
			TMP_FILE="/tmp/cm_clients_$$.json"

			awk '
			BEGIN {
				print "{\"clients\":["
				first = 1
			}
			# Load DHCP leases
			FILENAME ~ /dhcp\.leases$/ {
				mac = toupper($2)
				if (mac ~ /^([0-9A-F]{2}:){5}[0-9A-F]{2}$/) {
					ip[mac] = $3
					host[mac] = ($4 != "*") ? $4 : ""
					exp[mac] = $1
					seen[mac] = 1
				}
			}
			# Load ARP table
			FILENAME ~ /arp$/ {
				mac = toupper($4)
				if (mac ~ /^([0-9A-F]{2}:){5}[0-9A-F]{2}$/ && mac != "00:00:00:00:00:00" && $3 != "0x0") {
					if (!ip[mac]) ip[mac] = $1
					iface[mac] = $6
					seen[mac] = 1
				}
			}
			END {
				for (m in seen) {
					if (!first) printf ","
					first = 0
					printf "{\"mac\":\"%s\",\"ip\":\"%s\",\"hostname\":\"%s\",\"expires\":%s,\"interface\":\"%s\",\"wireless\":false}",
						m, ip[m], host[m], (exp[m] ? exp[m] : "0"), iface[m]
				}
				print "]}"
			}
			' /tmp/dhcp.leases /proc/net/arp > "$TMP_FILE" 2>/dev/null

			if [ -s "$TMP_FILE" ]; then
				cat "$TMP_FILE"
				rm -f "$TMP_FILE"
			else
				echo '{"clients":[]}'
			fi
			;;

		getClientDetail)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			if [ -z "$MAC" ]; then
				echo '{"error":"MAC address required"}'
				exit 0
			fi

			IP=""
			HOST=""
			EXP="0"
			IFACE=""

			if [ -f /tmp/dhcp.leases ]; then
				LINE=$(grep -i "$MAC" /tmp/dhcp.leases | head -n 1)
				if [ -n "$LINE" ]; then
					EXP=$(echo "$LINE" | awk '{print $1}')
					IP=$(echo "$LINE" | awk '{print $3}')
					H=$(echo "$LINE" | awk '{print $4}')
					[ "$H" != "*" ] && HOST="$H"
				fi
			fi

			if [ -z "$IP" ] && [ -f /proc/net/arp ]; then
				LINE=$(grep -i "$MAC" /proc/net/arp | head -n 1)
				if [ -n "$LINE" ]; then
					IP=$(echo "$LINE" | awk '{print $1}')
					IFACE=$(echo "$LINE" | awk '{print $6}')
				fi
			fi

			cat <<EOF
{
	"client": {
		"mac": "$MAC",
		"ip": "$IP",
		"hostname": "$HOST",
		"name": "",
		"owner": "",
		"notes": "",
		"icon": "",
		"groups": [],
		"expires": $EXP,
		"interface": "$IFACE",
		"wireless": false
	}
}
EOF
			;;

		setClientMeta)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			NAME=$(echo "$INPUT" | jsonfilter -e '@.name' 2>/dev/null)
			OWNER=$(echo "$INPUT" | jsonfilter -e '@.owner' 2>/dev/null)
			NOTES=$(echo "$INPUT" | jsonfilter -e '@.notes' 2>/dev/null)
			ICON=$(echo "$INPUT" | jsonfilter -e '@.icon' 2>/dev/null)

			if [ -z "$MAC" ]; then
				echo '{"error":"MAC address required"}'
				exit 0
			fi

			[ -f /etc/config/clientmanager ] || touch /etc/config/clientmanager

			SEC=""
			for s in $(uci -q show clientmanager | grep "=client" | cut -d. -f2 | cut -d= -f1); do
				smac=$(uci -q get clientmanager.$s.mac | tr 'a-z' 'A-Z')
				if [ "$smac" = "$MAC" ]; then
					SEC="$s"
					break
				fi
			done

			if [ -z "$SEC" ]; then
				SEC=$(uci add clientmanager client)
				uci set clientmanager.$SEC.mac="$MAC"
			fi

			[ -n "$NAME" ] && uci set clientmanager.$SEC.name="$NAME"
			[ -n "$OWNER" ] && uci set clientmanager.$SEC.owner="$OWNER"
			[ -n "$NOTES" ] && uci set clientmanager.$SEC.notes="$NOTES"
			[ -n "$ICON" ] && uci set clientmanager.$SEC.icon="$ICON"

			uci commit clientmanager
			echo '{"success":true}'
			;;

		getWifiInterfaces)
			IF_LIST="["
			FIRST=1
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show wireless 2>/dev/null | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
					mode=$(uci -q get wireless.$s.mode 2>/dev/null || echo "ap")
					if [ "$mode" = "ap" ]; then
						dev=$(uci -q get wireless.$s.device 2>/dev/null || true)
						ssid=$(uci -q get wireless.$s.ssid 2>/dev/null || true)
						mf=$(uci -q get wireless.$s.macfilter 2>/dev/null || echo "disable")
						dis=$(uci -q get wireless.$s.disabled 2>/dev/null || echo "0")
						[ "$FIRST" -eq 0 ] && IF_LIST="${IF_LIST},"
						FIRST=0
						IF_LIST="${IF_LIST}{\"section\":\"$s\",\"device\":\"$dev\",\"ssid\":\"$ssid\",\"mode\":\"$mode\",\"macfilter\":\"$mf\",\"disabled\":\"$dis\"}"
					fi
				done
			fi
			IF_LIST="${IF_LIST}]"
			echo "{\"interfaces\":$IF_LIST}"
			;;

		setMacFilter)
			SEC=$(echo "$INPUT" | jsonfilter -e '@.section' 2>/dev/null)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			ACT=$(echo "$INPUT" | jsonfilter -e '@.action' 2>/dev/null)

			if [ -n "$SEC" ] && [ -n "$MAC" ]; then
				if [ "$ACT" = "add" ]; then
					uci set wireless.$SEC.macfilter='allow'
					uci del_list wireless.$SEC.maclist="$MAC" 2>/dev/null || true
					uci add_list wireless.$SEC.maclist="$MAC"
				elif [ "$ACT" = "remove" ]; then
					uci del_list wireless.$SEC.maclist="$MAC" 2>/dev/null || true
				fi
				uci commit wireless
				wifi reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		setFirewallRule)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			ACT=$(echo "$INPUT" | jsonfilter -e '@.action' 2>/dev/null)

			if [ -n "$MAC" ]; then
				CLEAN_MAC=$(echo "$MAC" | tr -d ':')
				RULE_NAME="cm_${CLEAN_MAC}"

				# Remove existing rule with this name
				for s in $(uci -q show firewall | grep "\.name='${RULE_NAME}'" | cut -d. -f2); do
					uci delete firewall.$s 2>/dev/null || true
				done

				if [ "$ACT" = "block" ]; then
					SID=$(uci add firewall rule)
					uci set firewall.$SID.name="$RULE_NAME"
					uci set firewall.$SID.src="lan"
					uci set firewall.$SID.dest="wan"
					uci set firewall.$SID.src_mac="$MAC"
					uci set firewall.$SID.target="REJECT"
					uci set firewall.$SID.comment="Client Manager: block $MAC"
				fi
				uci commit firewall
				/etc/init.d/firewall reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		getFirewallRules)
			RULES="["
			FIRST=1
			if command -v uci >/dev/null 2>&1; then
				for s in $(uci -q show firewall 2>/dev/null | grep "=rule" | cut -d. -f2 | cut -d= -f1); do
					rname=$(uci -q get firewall.$s.name 2>/dev/null || true)
					case "$rname" in
						cm_*)
							smac=$(uci -q get firewall.$s.src_mac 2>/dev/null || true)
							target=$(uci -q get firewall.$s.target 2>/dev/null || true)
							comment=$(uci -q get firewall.$s.comment 2>/dev/null || true)
							[ "$FIRST" -eq 0 ] && RULES="${RULES},"
							FIRST=0
							RULES="${RULES}{\"section\":\"$s\",\"name\":\"$rname\",\"src_mac\":\"$smac\",\"target\":\"$target\",\"comment\":\"$comment\"}"
							;;
					esac
				done
			fi
			RULES="${RULES}]"
			echo "{\"rules\":$RULES}"
			;;

		deleteFirewallRule)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			if [ -n "$MAC" ]; then
				CLEAN_MAC=$(echo "$MAC" | tr -d ':')
				RULE_NAME="cm_${CLEAN_MAC}"
				for s in $(uci -q show firewall | grep "\.name='${RULE_NAME}'" | cut -d. -f2); do
					uci delete firewall.$s 2>/dev/null || true
				done
				uci commit firewall
				/etc/init.d/firewall reload >/dev/null 2>&1 &
			fi
			echo '{"success":true}'
			;;

		getBandwidth)
			CT=$(conntrack -L -o extended 2>/dev/null || true)
			if [ -n "$CT" ]; then
				TMP_BW="/tmp/cm_bw_$$.json"
				echo "$CT" | awk '
				BEGIN { print "{\"bandwidth\":[" ; first = 1 }
				/src=/ {
					# Extract first src IP and byte values
					match($0, /src=([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)/, ipm)
					match($0, /bytes=([0-9]+).+bytes=([0-9]+)/, bm)
					if (ipm[1] && bm[1] && bm[2]) {
						tx[ipm[1]] += bm[1]
						rx[ipm[1]] += bm[2]
						seen[ipm[1]] = 1
					}
				}
				END {
					for (ip in seen) {
						if (!first) printf ","
						first = 0
						tot = tx[ip] + rx[ip]
						printf "{\"ip\":\"%s\",\"tx\":%s,\"rx\":%s,\"bytes\":%s}", ip, tx[ip], rx[ip], tot
					}
					print "]}"
				}' > "$TMP_BW" 2>/dev/null

				if [ -s "$TMP_BW" ]; then
					cat "$TMP_BW"
					rm -f "$TMP_BW"
				else
					echo '{"bandwidth":[]}'
				fi
			else
				echo '{"bandwidth":[]}'
			fi
			;;

		getGroups)
			G_LIST="["
			FIRST=1
			if command -v uci >/dev/null 2>&1 && [ -f /etc/config/clientmanager ]; then
				for s in $(uci -q show clientmanager 2>/dev/null | grep "=group" | cut -d. -f2 | cut -d= -f1); do
					gid=$(uci -q get clientmanager.$s.id 2>/dev/null || echo "$s")
					gname=$(uci -q get clientmanager.$s.name 2>/dev/null || true)
					gdesc=$(uci -q get clientmanager.$s.description 2>/dev/null || true)
					gblk=$(uci -q get clientmanager.$s.block_internet 2>/dev/null || echo "0")
					[ "$FIRST" -eq 0 ] && G_LIST="${G_LIST},"
					FIRST=0
					G_LIST="${G_LIST}{\"section\":\"$s\",\"id\":\"$gid\",\"name\":\"$gname\",\"description\":\"$gdesc\",\"block_internet\":\"$gblk\"}"
				done
			fi
			G_LIST="${G_LIST}]"
			echo "{\"groups\":$G_LIST}"
			;;

		setGroup)
			GID=$(echo "$INPUT" | jsonfilter -e '@.id' 2>/dev/null)
			GNAME=$(echo "$INPUT" | jsonfilter -e '@.name' 2>/dev/null)
			GDESC=$(echo "$INPUT" | jsonfilter -e '@.description' 2>/dev/null)
			GBLK=$(echo "$INPUT" | jsonfilter -e '@.block_internet' 2>/dev/null)

			if [ -z "$GID" ]; then
				echo '{"error":"group id required"}'
				exit 0
			fi

			[ -f /etc/config/clientmanager ] || touch /etc/config/clientmanager

			SEC=""
			for s in $(uci -q show clientmanager | grep "=group" | cut -d. -f2 | cut -d= -f1); do
				sgid=$(uci -q get clientmanager.$s.id || echo "$s")
				if [ "$sgid" = "$GID" ]; then
					SEC="$s"
					break
				fi
			done

			if [ -z "$SEC" ]; then
				SEC=$(uci add clientmanager group)
				uci set clientmanager.$SEC.id="$GID"
			fi

			[ -n "$GNAME" ] && uci set clientmanager.$SEC.name="$GNAME"
			[ -n "$GDESC" ] && uci set clientmanager.$SEC.description="$GDESC"
			[ -n "$GBLK" ] && uci set clientmanager.$SEC.block_internet="$GBLK"

			uci commit clientmanager
			echo '{"success":true}'
			;;

		deleteGroup)
			GID=$(echo "$INPUT" | jsonfilter -e '@.id' 2>/dev/null)
			if [ -n "$GID" ]; then
				for s in $(uci -q show clientmanager | grep "=group" | cut -d. -f2 | cut -d= -f1); do
					sgid=$(uci -q get clientmanager.$s.id || echo "$s")
					if [ "$sgid" = "$GID" ]; then
						uci delete clientmanager.$s 2>/dev/null || true
					fi
				done
				uci commit clientmanager
			fi
			echo '{"success":true}'
			;;

		assignGroup)
			MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null | tr 'a-z' 'A-Z')
			GRP=$(echo "$INPUT" | jsonfilter -e '@.group' 2>/dev/null)
			ACT=$(echo "$INPUT" | jsonfilter -e '@.action' 2>/dev/null)

			if [ -n "$MAC" ] && [ -n "$GRP" ]; then
				SEC=""
				for s in $(uci -q show clientmanager | grep "=client" | cut -d. -f2 | cut -d= -f1); do
					smac=$(uci -q get clientmanager.$s.mac | tr 'a-z' 'A-Z')
					if [ "$smac" = "$MAC" ]; then
						SEC="$s"
						break
					fi
				done

				if [ -z "$SEC" ]; then
					SEC=$(uci add clientmanager client)
					uci set clientmanager.$SEC.mac="$MAC"
				fi

				if [ "$ACT" = "add" ]; then
					uci del_list clientmanager.$SEC.groups="$GRP" 2>/dev/null || true
					uci add_list clientmanager.$SEC.groups="$GRP"
				elif [ "$ACT" = "remove" ]; then
					uci del_list clientmanager.$SEC.groups="$GRP" 2>/dev/null || true
				fi
				uci commit clientmanager
			fi
			echo '{"success":true}'
			;;

		getHistory)
			if [ -f /tmp/clientmanager/history.json ]; then
				cat /tmp/clientmanager/history.json
			else
				echo '{"events":[]}'
			fi
			;;

		getStatistics)
			VNSTAT=$(vnstat --json 2>/dev/null || true)
			if [ -n "$VNSTAT" ]; then
				echo "{\"available\":true,\"source\":\"vnstat\",\"data\":$VNSTAT}"
			else
				echo '{"available":false}'
			fi
			;;

		*)
			echo '{"error":"Method not found"}'
			;;
	esac
	exit 0
fi

echo '{"error":"Invalid argument"}'
exit 1
